meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Bruno User",
    "email": "{{$randomEmail}}",
    "password": "starter12345"
  }
}

script:post-response {
  bru.setEnvVar("accessToken", res.body.accessToken);
  bru.setEnvVar("refreshToken", res.body.refreshToken);
}
