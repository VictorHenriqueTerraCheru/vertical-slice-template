# Copy to .env for local development: cp .env.example .env
# Lines starting with "# NAME=" are optional or environment-specific: uncomment to use.

# ---- Required in every environment ----

# Host port published by docker compose for the local database. Used only by docker-compose.yml. Default: 5432.
DB_PORT=5432

# Npgsql connection string. Required. Its port must match DB_PORT when using docker compose.
DB_CONNECTION=Host=localhost;Port=5432;Database=starter;Username=starter;Password=starter

# Key that signs the access tokens. Required, at least 32 characters.
# The "dev-only-" prefix marks the example key: the API refuses to start in Production with it.
JWT_KEY=dev-only-change-me-use-at-least-32-characters

# Issuer written into and required from every access token. Required.
JWT_ISSUER=starter-api

# Audience written into and required from every access token. Required.
JWT_AUDIENCE=starter-clients

# ---- Optional, defaults shown ----

# Access token lifetime in minutes.
# ACCESS_TOKEN_MINUTES=15

# Refresh token lifetime in days.
# REFRESH_TOKEN_DAYS=30

# Consecutive wrong passwords before the account is locked.
# LOCKOUT_MAX_FAILURES=5

# Lock duration in minutes.
# LOCKOUT_MINUTES=15

# Requests per minute, per client IP, accepted by register, login and forgot-password.
# RATE_LIMIT_AUTH_PER_MINUTE=10

# ---- Required in Production ----

# Comma-separated list of allowed front-end origins. Without it no origin is allowed by CORS.
# CORS_ORIGINS=https://app.example.com

# ---- Required in Staging and Production (Development and Testing only log the e-mail) ----

# SMTP server host.
# SMTP_HOST=

# SMTP server port.
# SMTP_PORT=587

# SMTP account user.
# SMTP_USER=

# SMTP account password.
# SMTP_PASSWORD=

# Sender display name.
# SMTP_SENDER_NAME=

# Sender e-mail address.
# SMTP_SENDER_EMAIL=

# Front-end page that receives the password reset token.
# PASSWORD_RESET_URL=https://app.example.com/reset-password

# ---- Optional in Staging and Production ----

# Administrator created at start-up. An existing account with this e-mail is promoted to administrator
# and keeps its password. Set both variables or neither; with neither, nobody is created.
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD=
