# Copy to .env for local development: cp .env.example .env
# Required in every environment

DB_PORT=5432
DB_CONNECTION=Host=localhost;Port=5432;Database=starter;Username=starter;Password=starter
JWT_KEY=dev-only-change-me-use-at-least-32-characters
JWT_ISSUER=starter-api
JWT_AUDIENCE=starter-clients

# Optional, defaults shown
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=30
# LOCKOUT_MAX_FAILURES=5
# LOCKOUT_MINUTES=15
# RATE_LIMIT_AUTH_PER_MINUTE=10

# Required in Production: comma-separated list of allowed front-end origins
# CORS_ORIGINS=https://app.example.com

# Required in Staging and Production
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SENDER_NAME=
# SMTP_SENDER_EMAIL=
# PASSWORD_RESET_URL=https://app.example.com/reset-password

# Administrator created on first start in Production
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD=
